{
  "expo": {
    "name": "Still",
    "slug": "still-voice-assistant",
    "version": "0.1.0",
    "icon": "./assets/still-icon.png",
    "orientation": "portrait",
    "scheme": "still",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.still.voiceassistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Still records voice notes only when you tap Record.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["processing"]
      }
    },
    "android": {
      "package": "com.still.voiceassistant",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Still to record voice notes when you choose.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Still to read the calendars you select and save events you approve.",
          "writeOnlyCalendarPermission": false,
          "remindersPermission": false,
          "writeOnlyAccess": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#969A9F",
          "defaultChannel": "reminders"
        }
      ],
      "expo-background-task",
      "expo-sharing",
      "expo-font",
      "expo-asset",
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
