{
  "name": "still-server-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-shared-controller.mjs",
    "build:release": "tsc -p tsconfig.json --sourceMap false --declaration false && node scripts/build-shared-controller.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "start": "node scripts/still-server.mjs start",
    "status": "node scripts/still-server.mjs status",
    "enroll": "node scripts/still-server.mjs enroll",
    "reset-password": "node scripts/still-server.mjs reset-password"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.0.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
