# These are public OAuth client IDs and exact, provider-registered redirect URIs.
# Never put an OAuth client secret in EXPO_PUBLIC_* or in the app bundle.
EXPO_PUBLIC_GOOGLE_NATIVE_CLIENT_ID=
# Reserved for a future confidential-backend exchange; Google web sign-in is disabled in this build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_NATIVE_REDIRECT_URI=
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=

# Optional server-only confidential OAuth registrations. Set both variables per provider.
# Keep client secrets in the server's private environment; never add them to EXPO_PUBLIC_*.
STILL_GOOGLE_CLIENT_ID=
STILL_GOOGLE_CLIENT_SECRET=
STILL_MICROSOFT_CLIENT_ID=
STILL_MICROSOFT_CLIENT_SECRET=

EXPO_PUBLIC_MICROSOFT_NATIVE_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_WEB_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_NATIVE_REDIRECT_URI=
EXPO_PUBLIC_MICROSOFT_WEB_REDIRECT_URI=
# Allowed: common, organizations, consumers, or a tenant UUID.
EXPO_PUBLIC_MICROSOFT_AUTHORITY=common
