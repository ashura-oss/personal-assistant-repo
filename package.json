{
  "name": "still-voice-assistant",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package --error-on-fail",
    "check:ios-config": "node scripts/check-ios-config.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.15",
    "expo-background-task": "~57.0.21",
    "expo-calendar": "~57.0.5",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "htmlparser2": "12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.13"
