# Copy to /etc/still/still.env and set root:root ownership with mode 0600.
# The app binds loopback itself; Caddy is the only public HTTP/TLS listener.
STILL_ORIGIN=https://still.example.com
STILL_PORT=8787
STILL_DATA_DIR=/var/lib/still/data
STILL_VAULT_KEY_FILE=/var/lib/still/keys/vault-root.key
STILL_FFMPEG_PATH=/usr/bin/ffmpeg
STILL_FFPROBE_PATH=/usr/bin/ffprobe

# Optional confidential OAuth configuration. Keep both values for each provider
# together and server-side only; never put client secrets in the web build.
# STILL_GOOGLE_CLIENT_ID=
# STILL_GOOGLE_CLIENT_SECRET=
# STILL_MICROSOFT_CLIENT_ID=
# STILL_MICROSOFT_CLIENT_SECRET=
