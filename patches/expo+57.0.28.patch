+/**
+ * Runs a response consumer while retaining ownership of Expo's native request.
+ * Unlike fetch(), this helper closes the JS response and awaits native task
+ * completion before returning, including when the consumer throws. Calling
+ * cancel() alone only requests cancellation.
+ */
+export async function withFetchLifetime<T>(
+  input: string | URL | FetchRequestLike,
+  init: FetchRequestInit | undefined,
+  consumeResponse: (response: FetchResponse) => Promise<T> | T,
+  onCancelPending?: (retryCancel: () => Promise<void>) => void,
+  beforeStart?: () => void
+): Promise<T> {
+  const initFromRequest = isRequest(input);
+  const url = initFromRequest ? input.url : input;
+  const body = dangerouslyGetBodyFromRequest(init) ?? (initFromRequest ? dangerouslyGetBodyFromRequest(input) : null);
+  const signal = init?.signal ?? (initFromRequest ? input.signal : undefined);
+  const redirect = init?.redirect ?? (initFromRequest ? input.redirect : undefined);
+  const method = init?.method ?? (initFromRequest ? input.method : undefined);
+  let credentials = init?.credentials ?? (initFromRequest ? input.credentials : undefined);
+  if (credentials === 'same-origin') credentials = 'include';
+  let headers = normalizeHeadersInit(init?.headers ?? (initFromRequest ? input.headers : undefined));
+  let abortSubscription: AbortSubscriptionCleanupFunction | null = null;
+  const response = new FetchResponse(() => { abortSubscription?.(); });
+  const request = new ExpoFetchModule.NativeRequest(response) as NativeRequest;
+  let requestStarted = false;
+  let abortedBeforeStart = Boolean(signal?.aborted);
+  let cancelAcknowledged = false;
+  let cancelFailed = false;
+  let activeCancel: Promise<void> | undefined;
+  let cancelPendingNotified = false;
+  let cancelPendingDiagnosticTimer: ReturnType<typeof setTimeout> | undefined;
+  let resolveCancelAcknowledged!: () => void;
+  const cancelAcknowledgement = new Promise<void>((resolve) => { resolveCancelAcknowledged = resolve; });
+  const retryCancel = (): Promise<void> => {
+    if (cancelAcknowledged) return Promise.resolve();
+    if (activeCancel) return activeCancel;
+    const pending = Promise.resolve().then(() => request.cancelAndWait());
+    activeCancel = pending;
+    cancelPendingDiagnosticTimer = setTimeout(() => {
+      cancelPendingDiagnosticTimer = undefined;
+      if (activeCancel === pending && !cancelAcknowledged && !cancelPendingNotified) {
+        cancelPendingNotified = true;
+        try { onCancelPending?.(retryCancel); } catch { /* Ownership remains held; observers cannot cancel cleanup. */ }
+      }
+    }, 1000);
+    void pending.then(() => {
+      if (cancelPendingDiagnosticTimer !== undefined) clearTimeout(cancelPendingDiagnosticTimer);
+      cancelPendingDiagnosticTimer = undefined;
+      cancelAcknowledged = true;
+      activeCancel = undefined;
+      resolveCancelAcknowledged();
+    }, () => {
+      if (cancelPendingDiagnosticTimer !== undefined) clearTimeout(cancelPendingDiagnosticTimer);
+      cancelPendingDiagnosticTimer = undefined;
+      activeCancel = undefined;
+      cancelFailed = true;
+      if (!cancelPendingNotified) {
+        cancelPendingNotified = true;
+        try { onCancelPending?.(retryCancel); } catch { /* Ownership remains held; observers cannot cancel cleanup. */ }
+      }
+    });
+    return pending;
+  };
+  abortSubscription = addAbortSignalListener(signal, () => {
+    abortedBeforeStart = true;
+    response.abort(signal?.reason);
+    if (requestStarted) void retryCancel().catch(() => {});
+  });
+
+  try {
+    const { body: requestBody, overriddenHeaders } = await normalizeBodyInitAsync(body);
+    if (overriddenHeaders) headers = overrideHeaders(headers, overriddenHeaders);
+    if (signal?.aborted || abortedBeforeStart) throw new FetchError('The operation was aborted.', { cause: signal?.reason });
+    const nativeRequestInit: NativeRequestInit = {
+      credentials: credentials ?? 'include',
+      headers,
+      method: method != null ? normalizeMethod(method) : 'GET',
+      redirect: redirect ?? 'follow',
+    };
+    // This synchronous fence runs after body normalization, immediately before
+    // native dispatch. It must not perform durable writes or await work.
+    beforeStart?.();
