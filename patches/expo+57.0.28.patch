+    try {
+      // Attach a rejection observer immediately; cleanup below retains the request until cancel is acknowledged.
+      const started = request.start(`${url}`, nativeRequestInit, requestBody);
+      void started.catch(() => {});
+      await started;
+    } catch (error: unknown) {
+      if (error instanceof Error) throw FetchError.createFromError(error);
+      throw new FetchError(String(error));
+    }
+    return await consumeResponse(response);
+  } finally {
+    abortSubscription?.();
