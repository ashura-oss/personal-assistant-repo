+++ b/node_modules/expo/ios/Fetch/FetchTaskLifetime.swift
@@ -0,0 +1,66 @@
+// Copyright 2015-present 650 Industries. All rights reserved.
+
+import Foundation
+
+/// Serial-queue-owned lifecycle for one URLSession task. Call every method on
+/// Expo's fetch request queue; completion means the delegate's terminal work
+/// has been processed, not merely that cancellation was requested.
+internal final class FetchTaskLifetime {
+  enum StartResult: Equatable {
+    case started
+    case alreadyStarted
+    case cancelledBeforeStart
+  }
+
+  private enum State: Equatable {
+    case notStarted
+    case running
+    case terminal
+  }
+
+  private var state: State = .notStarted
+  private var wasStarted = false
+  private var cancellationRequested = false
+  private var waiters: [@Sendable () -> Void] = []
+
+  func start() -> StartResult {
+    switch state {
+    case .notStarted:
+      wasStarted = true
+      state = .running
+      return .started
+    case .running:
+      return .alreadyStarted
+    case .terminal:
+      return wasStarted ? .alreadyStarted : .cancelledBeforeStart
+    }
+  }
+
+  func cancelAndWait(cancelTask: () -> Void, completion: @escaping @Sendable () -> Void) {
+    switch state {
+    case .terminal:
+      completion()
+    case .notStarted:
+      state = .terminal
+      cancellationRequested = true
+      completion()
+    case .running:
+      waiters.append(completion)
+      guard !cancellationRequested else {
+        return
+      }
+      cancellationRequested = true
+      cancelTask()
+    }
+  }
+
+  func didComplete() {
+    guard state != .terminal else {
+      return
+    }
+    state = .terminal
+    let completions = waiters
+    waiters.removeAll(keepingCapacity: false)
+    completions.forEach { $0() }
+  }
+}
