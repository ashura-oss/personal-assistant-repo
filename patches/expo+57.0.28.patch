+      // operation pending until an explicit retry is acknowledged.
+      if (!cancelAcknowledged && !cancelFailed) {
+        try { await retryCancel(); } catch { /* The owner remains held below. */ }
+      }
+      if (!cancelAcknowledged) await cancelAcknowledgement;
+    }
+  }
+}
