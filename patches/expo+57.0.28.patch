+      const started = request.start(`${url}`, nativeRequestInit, requestBody);
+      void started.catch(() => {});
+      await started;
+    } catch (error: unknown) {
+      if (error instanceof Error) throw FetchError.createFromError(error);
+      throw new FetchError(String(error));
+    }
